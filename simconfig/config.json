{
  "workloadpath": "simworkload/8192_workload.txt",
  "thread": 1,
  "gpu_type": "A100",                
  "gpus_per_server": 4,
  "nvswitch_per_server": 1,
  "pp_schedule": "gpipe",

  "network": {
    "ecmpmodel": 1,                  
    "max_jump": 5,
    "mtu": 4096,
    "normallink_rate": "224Gbps",
    "nvlink_rate": "2400Gbps",
    "normallink_delay": "5ns",
    "nvlink_delay": "15ns"
  },

  "workload": {
    "floadtime_s": 500
  },

  "mactable": {
    "load_enable": true,
    "dir": "mactable/topo-fattree_k-16_subnet-2_subnetk-8_gpusper-8_nvsper-1"
  },

  "pfc": {
    "drop_tail_queue_size": "50",
    "drop_tail_queue_num": "16",
    "high_watermark": 0.8,
    "low_watermark": 0.2,
    "log_level": "off"
  },

  "topology": {
    "model": "fattree",
    "k": 16,
    "subnet_model": 2,              
    "subnet_k": 8,                             
    "hostperleaf": 2,                            
    "switch_delay_ns_override": 100 
  },

  "roce": {
    "enable": true,
    "mode": "rc_3phase",
    "data_use_write": true,
    "sq_depth": 1024,
    "rq_depth": 1024,
    "transport_ack_enable": true,
    "transport_window_packets": 16,
    "reorder_window_packets": 4,
    "ack_timeout_mode": "auto",
    "ack_timeout_factor": 2.0,
    "ack_timeout_ns": 50000,
    "max_retransmissions": 8,
    "ether_type": "0x9999",
    "log_level": "off"
  },

  "debug": {
    "mem_log_enable": true,
    "mem_log_interval_s": 60,
    "mem_log_max_samples": 120,
    "mem_log_nodes": [0, 1, 2, 3, 8192, 8193, 9214, 9215],
    "mem_log_top_nodes": 4
  }

}
